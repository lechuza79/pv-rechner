#!/usr/bin/env bash
# Pre-commit guard for pv-rechner.
# Three checks, each blocks the commit on failure:
#   1. No staged .env* file ever ends up in a commit.
#   2. tsc --noEmit must pass on the staged tree, so import paths,
#      type errors and module-not-found errors are caught BEFORE
#      the commit lands. This catches the class of bug where files
#      get modified after `git mv` but the modifications are not
#      staged — locally the working tree compiles, but the commit
#      itself is broken and Vercel fails.
#   3. vitest run — unit tests must pass. Catches regressions in
#      calculation logic (PV economics, heat pump, chart utils)
#      that tsc cannot see. ~5 seconds on this project; if it ever
#      gets too slow, scope it down to changed files.
#
# Checks 2 and 3 run behind a queue (see below). Measured 26.08.2026:
# six concurrent type checks across parallel sessions took 29 minutes
# for two minutes of work — they starve each other on eight cores and
# one disk, and new ones keep arriving. Waiting costs nothing;
# competing costs everything.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ─── 1. Block .env* leaks ─────────────────────────────────────────
ENV_LEAK="$(git diff --cached --name-only --diff-filter=A | grep -E '(^|/)\.env(\.|$)' || true)"
if [ -n "$ENV_LEAK" ]; then
  echo "✖ pre-commit: refusing to commit .env file(s):"
  echo "$ENV_LEAK" | sed 's/^/    /'
  echo "  Remove with: git restore --staged <file> && add to .gitignore"
  exit 1
fi

# ─── Queue: only one expensive check at a time, repo-wide ─────────
# The lock lives in the SHARED git directory, so every worktree of
# this repo queues on the same lock while a different repo is
# unaffected. `mkdir` is the atomic primitive — macOS has no flock.
#
# Three ways out, so the queue can never wedge a commit:
#   · the holder's PID is gone      → take it over
#   · the lock is older than STALE  → take it over
#   · we waited longer than MAX     → run anyway, slowly
# Running anyway is deliberate: a queue that blocks a commit
# outright would be worse than the contention it prevents.
LOCK_DIR="$(git rev-parse --git-common-dir)/sc-precommit.lock"
LOCK_WAIT_MAX=900   # seconds we are willing to queue
LOCK_STALE=1800     # seconds after which a lock counts as abandoned
LOCK_HELD=0

release_lock() {
  [ "$LOCK_HELD" = "1" ] && rm -rf "$LOCK_DIR" 2>/dev/null || true
}
trap release_lock EXIT INT TERM

lock_age() {
  local started
  started="$(cat "$LOCK_DIR/started" 2>/dev/null || echo 0)"
  case "$started" in (*[!0-9]*|"") echo 0 ;; (*) echo $(( $(date +%s) - started )) ;; esac
}

acquire_lock() {
  local waited=0 holder="" announced=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    holder="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"

    # Holder died without cleaning up (kill -9, crash, closed session).
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      echo "  pre-commit: taking over an abandoned lock (PID $holder is gone)"
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi

    # No PID file, or a lock that outlived any plausible run.
    if [ -z "$holder" ] || [ "$(lock_age)" -gt "$LOCK_STALE" ]; then
      echo "  pre-commit: taking over a stale lock"
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi

    if [ "$waited" -ge "$LOCK_WAIT_MAX" ]; then
      echo "  pre-commit: waited ${waited}s, running anyway (the other check is slow, not stuck)"
      return 1
    fi

    if [ "$announced" = "0" ]; then
      echo "→ pre-commit: another session is checking (PID $holder) — queueing instead of competing"
      announced=1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done

  echo $$ > "$LOCK_DIR/pid"
  date +%s > "$LOCK_DIR/started"
  LOCK_HELD=1
  [ "$waited" -gt 0 ] && echo "  pre-commit: waited ${waited}s, our turn"
  return 0
}

acquire_lock || true

# ─── 2. TypeScript check on the working tree ──────────────────────
# We type-check the working tree (not the index) because tsc has no
# direct support for the staged state. In practice the difference
# only matters if you partially-stage a file — rare here, and even
# then a clean type-check is what we actually care about.
#
# `npm exec tsc` walks up directories to find tsc — that lets the
# hook work in worktrees that share node_modules with the main repo.
echo "→ pre-commit: tsc --noEmit"
if ! npm exec --no -- tsc --noEmit; then
  echo "✖ pre-commit: TypeScript check failed. Fix the errors above before committing."
  exit 1
fi

# ─── 3. Unit tests ────────────────────────────────────────────────
echo "→ pre-commit: vitest run"
if ! npm exec --no -- vitest run --reporter=dot; then
  echo "✖ pre-commit: tests failed. Fix the failing tests before committing."
  exit 1
fi

release_lock
LOCK_HELD=0

echo "✓ pre-commit: ok"
