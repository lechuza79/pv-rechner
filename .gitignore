# Alle Umgebungsdateien, nicht nur die *.local-Varianten — ein blankes .env
# oder .env.production war vorher nicht ignoriert. Der Pre-commit-Hook fängt
# das zwar ab, aber das ist die zweite Reihe, nicht die erste.
.env
.env.*
.vercel

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/

# MaStR refresh artifacts
scripts/.cache/
scripts/mastr-schema.json
scripts/mastr-bnetza-schema.json

# Signed legal documents (contracts, DPAs) — never commit
docs/legal/
scratch/

# Presse-Katalog: enthält Namen und Adressen von Journalistinnen und
# Journalisten. Das Repo ist öffentlich — dieselbe Trennung wie bei den
# Fachbetrieben und Versorgern, deren Sätze ausschließlich in der Datenbank
# liegen (RLS an, keine Policy). Erzeugt wird der Katalog mit
# `npm run presse -- --csv`.
docs/presse/
.werkbank/

# Protokoll der verschickten Sachfragen an Förderstellen. Enthält die
# Empfängeradresse und den Wortlaut — der Nachweis, was wann hinausging, gehört
# nicht in ein öffentliches Repo.
.foerder-anfragen/

# Generated municipal composition (rebuilt before the production build)
public/kommunen/
docs/design/kommunen/.generated*/

# Prepared landscape scenes are published to the Hetzner scene bucket
