[Unit]
Description=Solar Check bounded park wind snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/solar-check-park-weather
EnvironmentFile=/opt/solar-check-park-weather/weather.env
ExecStart=/opt/solar-check-park-weather/runtime/bin/node --import tsx scripts/park-wind-snapshot.ts
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=100%
Nice=15
TimeoutStartSec=10min
